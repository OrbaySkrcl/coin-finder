# --- required ---------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/coinfinder
REDIS_URL=redis://host:6379/0
TELEGRAM_BOT_TOKEN=

# --- optional ---------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_BASE=https://your-app.up.railway.app
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-app.up.railway.app
ENABLED_CHAINS=base,robinhood,bsc

# Comma-separated RPC overrides. Leave empty to use the built-in public pool.
# Set these if you ever move off free tiers - the code needs no other change.
BASE_RPC_URLS=
ROBINHOOD_RPC_URLS=
BSC_RPC_URLS=

# Ingestion tuning
WALLET_WATCH_BATCH=120
LOG_RANGE_BLOCKS=500
POLL_INTERVAL_SECONDS=12

# Signal engine
CONFLUENCE_MIN_CLUSTERS=3
CONFLUENCE_WINDOW_MINUTES=180
MIN_LIQUIDITY_USD=5000
